{
  "name": "echo-gate",
  "version": "0.1.0",
  "description": "Control layer for agent tools: registry, permissions, receipts, limits, and paid-call readiness.",
  "type": "module",
  "bin": {
    "echo-gate": "bin/echo-gate.js"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/src/server.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "deploy:vps": "scripts/deploy-vps.sh"
  },
  "keywords": [
    "agents",
    "mcp",
    "gateway",
    "receipts",
    "x402",
    "agent-tools"
  ],
  "author": "BuiltByEcho",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@hono/node-server": "^1.19.6",
    "@mariozechner/pi-tui": "^0.73.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "convex": "^1.34.4",
    "hono": "^4.10.7",
    "nanoid": "^5.1.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "ws": "8.20.1"
  }
}
